-- Wait for player
local Players = game:GetService("Players")
local player = Players.LocalPlayer or Players.PlayerAdded:Wait()
local mouse = player:GetMouse()

-- Determine the best parent for the GUI (Similar to Infinite Yield)
-- Uses gethui() or CoreGui if available (for executors), otherwise falls back to PlayerGui
local guiParent
if type(gethui) == "function" then
    guiParent = gethui()
else
    local success = pcall(function()
        return game:GetService("CoreGui").Name
    end)
    if success then
        guiParent = game:GetService("CoreGui")
    else
        guiParent = player:WaitForChild("PlayerGui")
    end
end

-- Create ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "Gui_" .. math.random(10000, 99999)
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 2147483647 -- Maximum value to ensure it renders on top of EVERYTHING
screenGui.IgnoreGuiInset = true -- Prevents the Roblox topbar from pushing the UI down
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Global
screenGui.Parent = guiParent

-- Main draggable frame
local mainFrame = Instance.new("Frame")
mainFrame.Parent = screenGui
mainFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
mainFrame.Size = UDim2.new(0, 200, 0, 100)
mainFrame.Position = UDim2.new(0.3, 0, 0.5, -50)
mainFrame.Draggable = true
mainFrame.Active = true

-- Status label
local status = Instance.new("TextLabel")
status.Parent = mainFrame
status.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
status.Size = UDim2.new(0, 200, 0, 30)
status.Position = UDim2.new(0, 0, 0, -30)
status.Text = "Status: Offline"
status.TextColor3 = Color3.fromRGB(255, 0, 0)
status.TextScaled = true

-- Helper to create a proper TextButton
local function createButton(name, text, x, y, width, height)
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Parent = mainFrame
    btn.Text = text
    btn.Size = UDim2.new(0, width, 0, height)
    btn.Position = UDim2.new(0, x, 0, y)
    btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextScaled = true
    btn.AutoButtonColor = true
    btn.BorderSizePixel = 0
    return btn
end

-- Create buttons (Organized into a 2x2 grid to keep the UI compact)
local onBtn = createButton("OnBtn", "On", 10, 20, 80, 30)
local offBtn = createButton("OffBtn", "Off", 110, 20, 80, 30)
local recoverBtn = createButton("RecoverBtn", "Recover", 10, 60, 80, 30)
local destroyBtn = createButton("DestroyBtn", "Destroy", 110, 60, 80, 30)

-- Functionality Variables
local buildingEnabled = false
local deletedParts = {}
local debounce = false
local clickConnection = nil

-- Improved Restoration Logic
-- Instead of :Destroy() and :Clone(), we set Parent to nil. 
-- This preserves all scripts, constraints (like door hinges), and internal states.
local function recoverParts()
    for _, data in ipairs(deletedParts) do
        if data.Instance then
            -- Restore the part to its exact original parent
            data.Instance.Parent = data.Parent
        end
    end
    deletedParts = {} -- Clear the cache after recovery
end

-- Status toggle functions
local function setOnline()
    if buildingEnabled then return end
    buildingEnabled = true
    status.Text = "Status: Online"
    status.TextColor3 = Color3.fromRGB(0, 255, 0)

    -- Connect mouse click
    clickConnection = mouse.Button1Down:Connect(function()
        if buildingEnabled and not debounce then
            debounce = true
            local target = mouse.Target
            
            -- Ensure we have a target and we aren't accidentally clicking the GUI
            if target and not target:IsDescendantOf(screenGui) then
                -- Cache the instance and its original parent
                table.insert(deletedParts, {
                    Instance = target,
                    Parent = target.Parent
                })
                
                -- "Delete" it by removing it from the workspace safely
                target.Parent = nil
            end
            
            task.wait(0.1) -- Modern wait function
            debounce = false
        end
    end)
end

local function setOffline()
    if not buildingEnabled then return end
    buildingEnabled = false
    status.Text = "Status: Offline"
    status.TextColor3 = Color3.fromRGB(255, 0, 0)
    
    -- Disconnect the mouse event to prevent memory leaks
    if clickConnection then
        clickConnection:Disconnect()
        clickConnection = nil
    end
end

local function destroyGui()
    setOffline()
    recoverParts() -- Automatically recover everything before destroying the GUI
    screenGui:Destroy()
end

-- Connect clicks
onBtn.MouseButton1Click:Connect(setOnline)
offBtn.MouseButton1Click:Connect(setOffline)
recoverBtn.MouseButton1Click:Connect(recoverParts)
destroyBtn.MouseButton1Click:Connect(destroyGui)
