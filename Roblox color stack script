local function getBoardCenter(obj)
    if obj:IsA("Model") then
        local success, cf = pcall(function() return obj:GetBoundingBox() end)
        if success and cf then return cf.Position end
        return obj:GetPivot().Position
    elseif obj:IsA("BasePart") then
        return obj.Position
    end
    return nil
end

local function findTargetBoard()
    local char = player.Character
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso"))
    if not root then return nil end

    local rootPos = root.Position
    local cam = workspace.CurrentCamera
    local camPos = cam and cam.CFrame.Position or rootPos
    local camLook = cam and cam.CFrame.LookVector or root.CFrame.LookVector

    local allBoards = {}
    for _, obj in ipairs(workspace:GetDescendants()) do
        if (obj.Name == "StackBoard1" or obj.Name == "StackBoard2") and (obj:IsA("Model") or obj:IsA("BasePart")) then
            if not (obj.Parent and (obj.Parent.Name == "StackBoard1" or obj.Parent.Name == "StackBoard2")) then
                table.insert(allBoards, obj)
            end
        end
    end

    if #allBoards == 0 then return nil end

    local bestBoard = nil
    local bestScore = -math.huge

    for _, board in ipairs(allBoards) do
        local pos = getBoardCenter(board)
        if pos then
            local toBoardCam = pos - camPos
            local camDir = toBoardCam.Unit
            local camDot = camLook:Dot(camDir)
            local forwardProj = math.max(0, toBoardCam:Dot(camLook))
            local rayPoint = camPos + (camLook * forwardProj)
            local perpDist = (pos - rayPoint).Magnitude
            local charDist = (pos - rootPos).Magnitude

            local score = (camDot * 100) - (perpDist * 5.0) - (charDist * 1.5)
            if score > bestScore then
                bestScore = score
                bestBoard = board
            end
        end
    end

    return bestBoard
end

local function parseBlockInfo(part)
    if not part:IsA("BasePart") then return nil end
    if part.Transparency >= 0.9 or (part.LocalTransparencyModifier and part.LocalTransparencyModifier >= 0.9) then
        return nil
    end

    local name = part.Name
    local colorWord = string.match(name, "^Block_%d+_%d+_(%a+)") or string.match(name, "^Block_.*_(%a+)$")
    if not colorWord then return nil end

    local id = COLOR_NAME_MAP[string.lower(colorWord)] or 1
    return {
        part = part,
        colorId = id,
        actualColor = part.Color or COLOR_PALETTE[id]
    }
end

local function stepCopyMirror()
    if not isCopying or not isAlive then return end

    local t = (math.sin(os.clock() * 3.8) + 1) * 0.5
    local redColor = Color3.fromRGB(235, 60, 60)
    local blueColor = Color3.fromRGB(50, 140, 245)
    startBtn.BackgroundColor3 = redColor:Lerp(blueColor, t)
    startBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    startBtn.Text = isSolving3D and "Stop (3D)" or "Start (3D)"

    local now = os.clock()
    if now - lastCopyScan < COPY_SCAN_INTERVAL then
        return
    end
    lastCopyScan = now

    if not currentTrackedBoard or not currentTrackedBoard.Parent then
        currentTrackedBoard = findTargetBoard()
        table.clear(cachedCylinders)
        if not currentTrackedBoard then
            if not isSolving3D then
                statsLabel.Text = "Copying: Searching facing board..."
            end
            return
        end
    end

    local board = currentTrackedBoard
    local boardPos = getBoardCenter(board) or Vector3.zero

    if #cachedCylinders == 0 then
        for _, obj in ipairs(board:GetDescendants()) do
            if obj:IsA("BasePart") then
                local cNum = string.match(obj.Name, "^Cylinder(%d+)$")
                if cNum then cachedCylinders[tonumber(cNum)] = obj end
            end
        end
        if #cachedCylinders == 0 and board.Parent then
            for _, obj in ipairs(board.Parent:GetDescendants()) do
                if obj:IsA("BasePart") then
                    local cNum = string.match(obj.Name, "^Cylinder(%d+)$")
                    if cNum then cachedCylinders[tonumber(cNum)] = obj end
                end
            end
        end
    end

    local cylinders = cachedCylinders
    local maxCyl = 0
    for i = 8, 1, -1 do
        if cylinders[i] then
            maxCyl = math.max(maxCyl, i)
        end
    end

    local detectedCount = maxCyl
    if detectedCount ~= 4 and detectedCount ~= 5 and detectedCount ~= 6 and detectedCount ~= 8 then
        detectedCount = (detectedCount >= 8 and 8) or (detectedCount >= 6 and 6) or (detectedCount >= 5 and 5) or 4
    end

    if detectedCount ~= currentMode then
        currentMode = detectedCount
        changeBtn.Text = string.format("Mode (%d)", currentMode)
        table.clear(pendingLandings)
        mismatchDetected = false
        rebuildCylinders()
    end

    local searchScope = board.Parent or board
    local allBlocks = {}

    for _, obj in ipairs(searchScope:GetDescendants()) do
        local info = parseBlockInfo(obj)
        if info then
            local part = info.part
            local pPos = part.Position
            local distToThis = (pPos - boardPos).Magnitude

            if distToThis < 28 then
                table.insert(allBlocks, info)
            end
        end
    end

    -- Clean up stale tracked block positions
    for p in pairs(prevBlockPositions) do
        if not p:IsDescendantOf(workspace) then
            prevBlockPositions[p] = nil
        end
    end

    local newTubes = {}
    local newColors = {}
    local tubeBlockLists = {}
    for i = 1, currentMode do
        newTubes[i] = {}
        newColors[i] = {}
        tubeBlockLists[i] = {}
    end

    local hoveringTube = nil
    local movingBlockInfo = nil
    local cfg = LAYOUT_CONFIG[currentMode] or LAYOUT_CONFIG[4]
    local elevatedCylinders = 0

    for _, bInfo in ipairs(allBlocks) do
        local pPos = bInfo.part.Position
        local partRef = bInfo.part
        local bestTubeIdx = nil
        local bestDistXZ = math.huge
        local secondTubeIdx = nil
        local secondDistXZ = math.huge

        for i = 1, currentMode do
            local cyl = cylinders[i]
            if cyl then
                local dXZ = (Vector2.new(pPos.X, pPos.Z) - Vector2.new(cyl.Position.X, cyl.Position.Z)).Magnitude
                if dXZ < bestDistXZ then
                    secondTubeIdx = bestTubeIdx
                    secondDistXZ = bestDistXZ
                    bestDistXZ = dXZ
                    bestTubeIdx = i
                elseif dXZ < secondDistXZ then
                    secondDistXZ = dXZ
                    secondTubeIdx = i
                end
            end
        end

        local cylRef = bestTubeIdx and cylinders[bestTubeIdx]
        local cylRadius = cylRef and (math.max(cylRef.Size.X, cylRef.Size.Z) * 0.85) or 3

        if bestTubeIdx and cylRef then
            local topY = cylRef.Position.Y + (cylRef.Size.Y * 0.5)

            -- Track movement velocity & position delta to filter out stationary spawn props
            local vel = 0
            if partRef:IsA("BasePart") then
                vel = partRef.AssemblyLinearVelocity.Magnitude
            end
            local lastP = prevBlockPositions[partRef]
            local movedDist = lastP and (pPos - lastP).Magnitude or 0
            prevBlockPositions[partRef] = pPos

            local isStationary = (vel < 0.2 and movedDist < 0.05)

            if bestDistXZ <= cylRadius then
                if pPos.Y > (topY + 0.08) then
                    hoveringTube = bestTubeIdx
                    bInfo.isHover = true
                    elevatedCylinders = elevatedCylinders + 1
                else
                    bInfo.isHover = false
                    table.insert(tubeBlockLists[bestTubeIdx], bInfo)
                end
            else
                -- IGNORE STATIONARY SPAWN BLOCKS: only active blocks in transit show on 2D mirror
                if not isStationary then
                    movingBlockInfo = {
                        info = bInfo,
                        fromIdx = bestTubeIdx,
                        toIdx = secondTubeIdx,
                        d1 = bestDistXZ,
                        d2 = secondDistXZ
                    }
                end
            end
        end
    end

    if elevatedCylinders >= 3 then
        if isSolving3D then
            isSolving3D = false
            table.clear(pendingLandings)
            mismatchDetected = false
            statsLabel.Text = "Round Over / Resetting."
        end
        isRoundResetting = true
    elseif elevatedCylinders == 0 and #allBlocks >= currentMode then
        if isRoundResetting then
            isRoundResetting = false
            rebuildCylinders()
        end
    end

    for i = 1, currentMode do
        local list = tubeBlockLists[i]
        table.sort(list, function(a, b)
            return a.part.Position.Y < b.part.Position.Y
        end)

        for slotIdx = 1, math.min(#list, currentMode) do
            local b = list[slotIdx]
            table.insert(newTubes[i], b.colorId)
            table.insert(newColors[i], b.actualColor)
        end
    end

    if #pendingLandings > 0 and not isRoundResetting then
        for i = 1, currentMode do
            local prevCount = previousTubesCounts[i] or 0
            local newCount = #newTubes[i]

            if newCount > prevCount then
                local matchedIdx = nil
                for pIdx, pending in ipairs(pendingLandings) do
                    if pending.to == i then
                        matchedIdx = pIdx
                        break
                    end
                end

                if matchedIdx then
                    table.remove(pendingLandings, matchedIdx)
                else
                    mismatchDetected = true
                end
            end
        end

        local curTime = os.clock()
        for _, pending in ipairs(pendingLandings) do
            if curTime - pending.timestamp > 1.6 then
                mismatchDetected = true
                break
            end
        end
    end

    for i = 1, currentMode do
        previousTubesCounts[i] = #newTubes[i]
    end

    tubes = newTubes
    tubeCustomColors = newColors
    currentHoverTube = hoveringTube
    selectedTube = hoveringTube

    if movingBlockInfo and tubeButtons[movingBlockInfo.fromIdx] and tubeButtons[movingBlockInfo.toIdx] then
        local btnA = tubeButtons[movingBlockInfo.fromIdx]
        local btnB = tubeButtons[movingBlockInfo.toIdx]
        local totalD = movingBlockInfo.d1 + movingBlockInfo.d2
        local alpha = (totalD > 0) and math.clamp(movingBlockInfo.d1 / totalD, 0, 1) or 0.5

        local xA = btnA.Position.X.Offset
        local xB = btnB.Position.X.Offset
        local yA = btnA.Position.Y.Offset
        local yB = btnB.Position.Y.Offset

        local currentX = xA + ((xB - xA) * alpha) + 2
        local currentY = yA + ((yB - yA) * alpha) + cfg.hoverY

        transitBlock.BackgroundColor3 = movingBlockInfo.info.actualColor
        transitBlock.Position = UDim2.new(0, currentX, 0, currentY)
        transitBlock.Visible = true
    else
        transitBlock.Visible = false
    end

    updateVisuals()
    if not isSolving3D and not isRoundResetting then
        local tableName = board.Parent and board.Parent.Name or "Table"
        statsLabel.Text = string.format("Copying: %s (%s) | %d Cyl", board.Name, tableName, currentMode)
    end
end

local function toggleCopy()
    isCopying = not isCopying
    stopTimer()
    isSolving = false
    isSolving3D = false
    isRoundResetting = false
    selectedTube = nil
    currentHoverTube = nil
    currentTrackedBoard = nil
    table.clear(cachedCylinders)
    table.clear(pendingLandings)
    table.clear(prevBlockPositions)
    mismatchDetected = false
    updateButtonLockVisuals()

    if isCopying then
        table.clear(previousTubesCounts)
        if copyLoopConn then copyLoopConn:Disconnect() end
        copyLoopConn = RunService.Heartbeat:Connect(stepCopyMirror)
        registerCleanup(copyLoopConn)
        statsLabel.Text = "Copying: Scanning Workspace..."
    else
        if copyLoopConn then
            copyLoopConn:Disconnect()
            copyLoopConn = nil
        end
        table.clear(previousTubesCounts)
        transitBlock.Visible = false
        statsLabel.Text = "Copy: OFF | Ready"
        updateVisuals()
    end
end

-- ============================================================================
-- ON / OFF TOGGLE CONTROLS
-- ============================================================================
local function setOnline()
    status.Text = "Status: Online"
    status.TextColor3 = Color3.fromRGB(50, 230, 80)
    
    mainFrame:TweenSize(UDim2.new(0, 174, 0, 234), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true)
    task.delay(0.15, function()
        if isAlive then
            gameContainer.Visible = true
            rebuildCylinders()
            randomizeGame()
        end
    end)
end

local function setOffline()
    status.Text = "Status: Offline"
    status.TextColor3 = Color3.fromRGB(255, 75, 75)
    
    if isCopying then
        toggleCopy()
    end
    isSolving = false
    isSolving3D = false
    isRoundResetting = false
    stopTimer()
    gameContainer.Visible = false
    mainFrame:TweenSize(UDim2.new(0, 174, 0, 44), Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true)
end

registerCleanup(onBtn.MouseButton1Click:Connect(setOnline))
registerCleanup(offBtn.MouseButton1Click:Connect(setOffline))
registerCleanup(destroyBtn.MouseButton1Click:Connect(cleanup))
registerCleanup(randomizeBtn.MouseButton1Click:Connect(randomizeGame))
registerCleanup(startBtn.MouseButton1Click:Connect(onStartClicked))
registerCleanup(changeBtn.MouseButton1Click:Connect(switchMode))
registerCleanup(copyBtn.MouseButton1Click:Connect(toggleCopy))
