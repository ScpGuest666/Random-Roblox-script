local function restoreOriginalRobloxControls()
    pcall(function()
        local pGui = player:FindFirstChild("PlayerGui")
        if pGui then
            local tg = pGui:FindFirstChild("TouchGui")
            if tg then
                tg.Enabled = true
            end
        end
    end)

    pcall(function()
        local UserGameSettings = UserSettings():GetService("UserGameSettings")
        if originalTouchMovementMode then
            UserGameSettings.TouchMovementMode = originalTouchMovementMode
        else
            UserGameSettings.TouchMovementMode = Enum.TouchMovementMode.Default
        end
    end)

    pcall(function()
        if player then
            if originalDevTouchMovementMode then
                player.DevTouchMovementMode = originalDevTouchMovementMode
            else
                player.DevTouchMovementMode = Enum.DevTouchMovementMode.UserChoice
            end
        end
    end)

    pcall(function()
        local char = player.Character
        if char then
            local hum = char:FindFirstChildOfClass("Humanoid")
            if hum then
                hum:Move(Vector3.zero, false)
            end
        end
    end)

    pcall(function()
        local PlayerScripts = player:FindFirstChild("PlayerScripts")
        if PlayerScripts then
            local PlayerModule = PlayerScripts:FindFirstChild("PlayerModule")
            if PlayerModule then
                local controls = require(PlayerModule)
                if controls and controls.GetControls then
                    local activeControls = controls:GetControls()
                    if activeControls and activeControls.Enable then
                        activeControls:Enable()
                    end
                end
            end
        end
    end)
end

local function cleanup()
    isAlive = false
    restoreOriginalRobloxControls()

    for _, item in ipairs(cleanupTasks) do
        pcall(function()
            if typeof(item) == "RBXScriptConnection" then
                item:Disconnect()
            elseif typeof(item) == "Instance" then
                item:Destroy()
            elseif type(item) == "thread" then
                task.cancel(item)
            elseif type(item) == "function" then
                item()
            end
        end)
    end
    table.clear(cleanupTasks)
    if genv.MyScript_Cleanup == cleanup then
        genv.MyScript_Cleanup = nil
    end
end

genv.MyScript_Cleanup = cleanup

