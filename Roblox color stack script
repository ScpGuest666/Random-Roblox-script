registerCleanup(RunService.RenderStepped:Connect(function()
    if not isAlive then return end
    local char = player.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if currentMoveVector.Magnitude > 0.05 then
        local cam = workspace.CurrentCamera
        if cam then
            local camCF = cam.CFrame
            local flatForward = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z).Unit
            local flatRight = Vector3.new(camCF.RightVector.X, 0, camCF.RightVector.Z).Unit
            local moveDir = (flatRight * currentMoveVector.X) + (flatForward * -currentMoveVector.Y)
            hum:Move(moveDir, false)
        end
    end

    if isJumpHeld then
        hum.Jump = true
    end
end))

