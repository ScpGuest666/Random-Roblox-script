-- ============================================================================
-- FAST HEURISTIC SOLVER HELPERS (ZERO ALLOCATION GC SAFE)
-- ============================================================================
local function cloneTubes(st)
    local n = {}
    for i = 1, currentMode do
        n[i] = {}
        for j = 1, #st[i] do
            n[i][j] = st[i][j]
        end
    end
    return n
end

local function fastHash(st)
    local parts = {}
    for i = 1, currentMode do
        local u = st[i]
        local s = ""
        for j = 1, #u do
            s = s .. string.char(48 + u[j])
        end
        parts[i] = s
    end
    table.sort(parts)
    return table.concat(parts, "|")
end

local function calculateSmartHeuristic(st)
    local cap = currentMode
    local score = 0

    for i = 1, cap do
        local tube = st[i]
        local len = #tube
        if len > 0 then
            local base = tube[1]
            local pureCount = 0
            local contaminated = false
            for k = 1, len do
                if tube[k] == base and not contaminated then
                    pureCount = pureCount + 1
                else
                    contaminated = true
                end
            end

            if pureCount == cap then
                score = score - 400
            else
                score = score - (pureCount * 25)
                score = score + ((len - pureCount) * 15)
            end

            for k = 1, len - 1 do
                if tube[k] == tube[k + 1] then
                    score = score - 12
                end
            end
        else
            score = score - 50
        end
    end
    return score
end

local function getValidSuccessors(st)
    local moves = {}
    local cap = currentMode
    local seenEmptyDest = false

    for from = 1, cap do
        local fromTube = st[from]
        local fromLen = #fromTube
        if fromLen > 0 then
            local isDone = (fromLen == cap)
            if isDone then
                local b = fromTube[1]
                for s = 2, cap do
                    if fromTube[s] ~= b then isDone = false; break end
                end
            end

            if not isDone then
                local movingColor = fromTube[fromLen]

                for to = 1, cap do
                    if from ~= to then
                        local toTube = st[to]
                        local toLen = #toTube

                        if toLen < cap then
                            local isToEmpty = (toLen == 0)
                            local allow = true

                            if isToEmpty then
                                if seenEmptyDest then
                                    allow = false
                                else
                                    seenEmptyDest = true
                                end

                                local isFromPure = true
                                for k = 1, fromLen do
                                    if fromTube[k] ~= movingColor then
                                        isFromPure = false
                                        break
                                    end
                                end
                                if isFromPure then
                                    allow = false
                                end
                            end

                            if allow then
                                local isMatch = (toLen > 0 and toTube[toLen] == movingColor)
                                table.insert(moves, {
                                    from = from,
                                    to = to,
                                    isMatch = isMatch
                                })
                            end
                        end
                    end
                end
            end
        end
    end

    table.sort(moves, function(a, b)
        if a.isMatch ~= b.isMatch then
            return a.isMatch
        end
        return false
    end)

    return moves
end

-- 0ms / 3ms Instant Solver using Linked Parent Pointers (Zero Memory Bloat)
local function findFastSolvePath(initialTubes)
    if isGameWon(initialTubes) then return {} end

    local heap = {}
    local function pushHeap(item)
        table.insert(heap, item)
        local idx = #heap
        while idx > 1 do
            local parent = math.floor(idx / 2)
            if heap[idx].f < heap[parent].f then
                heap[idx], heap[parent] = heap[parent], heap[idx]
                idx = parent
            else
                break
            end
        end
    end

    local function popHeap()
        if #heap == 0 then return nil end
        local top = heap[1]
        local last = table.remove(heap)
        if #heap > 0 then
            heap[1] = last
            local idx = 1
            local n = #heap
            while true do
                local left = 2 * idx
                local right = 2 * idx + 1
                local smallest = idx
                if left <= n and heap[left].f < heap[smallest].f then smallest = left end
                if right <= n and heap[right].f < heap[smallest].f then smallest = right end
                if smallest ~= idx then
                    heap[idx], heap[smallest] = heap[smallest], heap[idx]
                    idx = smallest
                else
                    break
                end
            end
        end
        return top
    end

    local startHash = fastHash(initialTubes)
    local visited = {[startHash] = true}

    local startNode = {
        state = cloneTubes(initialTubes),
        parent = nil,
        move = nil,
        cost = 0,
        h = calculateSmartHeuristic(initialTubes),
        f = calculateSmartHeuristic(initialTubes)
    }

    pushHeap(startNode)

    local bestNode = startNode
    local iterations = 0
    local maxIterations = (currentMode == 8) and 1000 or 3000

    while #heap > 0 do
        iterations = iterations + 1
        if not isAlive or (not isSolving and not isSolving3D) then return nil end

        local cur = popHeap()
        local st = cur.state

        if isGameWon(st) then
            local path = {}
            local walk = cur
            while walk and walk.move do
                table.insert(path, 1, walk.move)
                walk = walk.parent
            end
            return path
        end

        if cur.h < bestNode.h then
            bestNode = cur
        end

        if iterations >= maxIterations then
            break
        end

        local succs = getValidSuccessors(st)
        for _, move in ipairs(succs) do
            local nextSt = cloneTubes(st)
            local val = table.remove(nextSt[move.from])
            table.insert(nextSt[move.to], val)

            local nHash = fastHash(nextSt)
            if not visited[nHash] then
                visited[nHash] = true

                local nCost = cur.cost + 1
                local nH = calculateSmartHeuristic(nextSt)
                local nF = nCost + nH

                pushHeap({
                    state = nextSt,
                    parent = cur,
                    move = {from = move.from, to = move.to},
                    cost = nCost,
                    h = nH,
                    f = nF
                })
            end
        end
    end

    local path = {}
    local walk = bestNode
    while walk and walk.move do
        table.insert(path, 1, walk.move)
        walk = walk.parent
    end
    return path
end

-- ============================================================================
-- HYPER-VELOCITY MOVE DISPATCHER
-- ============================================================================
local function executeFastMove(fromIdx, toIdx, initialFromCount)
    local hover = getHoveringTube()

    if hover ~= nil then
        if hover == fromIdx then
            simulateKeyPress(toIdx)
        else
            simulateKeyPress(hover)
            task.wait(0.02)
            simulateKeyPress(fromIdx)
            task.wait(0.02)
            simulateKeyPress(toIdx)
        end
    else
        simulateKeyPress(fromIdx)
        task.wait(0.02)
        simulateKeyPress(toIdx)
    end

    local disappearWait = os.clock()
    local disappeared = false

    while os.clock() - disappearWait < 0.25 do
        if (#tubes[fromIdx] or 0) < initialFromCount and getHoveringTube() ~= fromIdx then
            disappeared = true
            break
        end
        task.wait()
    end

    return disappeared
end

-- ============================================================================
-- 3D SOLVER CONTINUOUS EXECUTION PIPELINE (WITH ANTI-LAG THROTTLE)
-- ============================================================================
local function toggle3DSolver()
    if not isCopying then return end

    if isSolving3D then
        isSolving3D = false
        table.clear(pendingLandings)
        mismatchDetected = false
        statsLabel.Text = "3D Solver Stopped."
        return
    end

    if isRoundResetting then
        statsLabel.Text = "Cannot start: Round ending / resetting."
        return
    end

    if isGameWon(tubes) and getHoveringTube() == nil then
        statsLabel.Text = "Board is already solved!"
        return
    end

    isSolving3D = true
    table.clear(pendingLandings)
    mismatchDetected = false

    task.spawn(function()
        local emptyPathCount = 0

        while isSolving3D and not (isGameWon(tubes) and getHoveringTube() == nil) do
            if not isAlive or not isCopying or isRoundResetting then break end

            -- Failsafe throttle: wait for pending blocks to settle physically before triggering another search
            if #pendingLandings > 0 then
                local settleStart = os.clock()
                while #pendingLandings > 0 and (os.clock() - settleStart < 0.45) and not isRoundResetting do
                    task.wait(0.03)
                end
            end

            -- Failsafe: if a block was left hovering, immediately drop it
            local floatingTube = getHoveringTube()
            if floatingTube then
                simulateKeyPress(floatingTube)
                task.wait(0.05)
            end

            if isGameWon(tubes) and getHoveringTube() == nil then
                break
            end

            statsLabel.Text = "Analyzing clean path..."
            local path = findFastSolvePath(tubes)

            if not path or #path == 0 then
                emptyPathCount = emptyPathCount + 1
                if emptyPathCount > 4 then
                    if getHoveringTube() then
                        simulateKeyPress(getHoveringTube())
                    end
                    statsLabel.Text = "3D: Syncing with live board..."
                    task.wait(0.15)
                else
                    task.wait(0.03)
                end
            else
                emptyPathCount = 0

                local pIdx = 1
                while pIdx <= #path do
                    if not isAlive or not isCopying or not isSolving3D or isRoundResetting then break end

                    local move = path[pIdx]
                    local fromIdx = move.from
                    local toIdx = move.to

                    statsLabel.Text = string.format("3D: %d/%d (Tube %d -> %d)", pIdx, #path, fromIdx, toIdx)

                    if isCylinderAwaitingArrival(fromIdx) then
                        local waitArrival = os.clock()
                        while isCylinderAwaitingArrival(fromIdx) and (os.clock() - waitArrival < 1.4) do
                            if isRoundResetting then break end
                            task.wait()
                        end
                    end

                    if isRoundResetting then break end

                    local initialFromCount = #tubes[fromIdx] or 0
                    local movingColor = tubes[fromIdx] and tubes[fromIdx][initialFromCount]
                    local disappeared = executeFastMove(fromIdx, toIdx, initialFromCount)

                    if disappeared then
                        table.insert(pendingLandings, {
                            from = fromIdx,
                            to = toIdx,
                            color = movingColor,
                            timestamp = os.clock()
                        })
                        pIdx = pIdx + 1
                    else
                        task.wait(0.03)
                    end

                    if mismatchDetected and not isRoundResetting then
                        mismatchDetected = false
                        statsLabel.Text = "Re-aligning live board..."
                        local settleWait = os.clock()
                        while os.clock() - settleWait < 0.25 do
                            if getHoveringTube() == nil or isRoundResetting then break end
                            task.wait()
                        end
                        table.clear(pendingLandings)
                        break
                    end

                    task.wait()
                end
            end

            task.wait(0.03)
        end

        -- Final verification & settle down
        local finalWait = os.clock()
        while #pendingLandings > 0 and (os.clock() - finalWait < 1.0) and not isRoundResetting do
            task.wait()
        end

        if getHoveringTube() then
            simulateKeyPress(getHoveringTube())
            task.wait(0.05)
        end

        table.clear(pendingLandings)
        isSolving3D = false

        if isRoundResetting then
            statsLabel.Text = "Round Over / Resetting."
        elseif isGameWon(tubes) and getHoveringTube() == nil then
            statsLabel.Text = "3D Board Solved! Win Registered."
        else
            statsLabel.Text = "3D Moves Complete."
        end
    end)
end

