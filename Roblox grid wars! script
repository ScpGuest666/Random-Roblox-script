-- ============================================================================
local function clearActiveHighlights()
    if activeTableConn then
        activeTableConn:Disconnect()
        activeTableConn = nil
    end

    if activePredictionPart then
        pcall(function() activePredictionPart:Destroy() end)
        activePredictionPart = nil
        activePredictionBillboard = nil
        activeBillboardText = nil
        currentTargetEdge = nil
    end

    for part, hl in pairs(activeWallHighlights) do
        pcall(function()
            if typeof(hl) == "Instance" then
                hl:Destroy()
            end
        end)
    end
    table.clear(activeWallHighlights)
end

local function cleanup()
    isAlive = false
    isOnline = false
    clearActiveHighlights()

    for _, item in ipairs(cleanupTasks) do
        pcall(function()
            if typeof(item) == "RBXScriptConnection" then
                item:Disconnect()
            elseif typeof(item) == "Instance" then
                item:Destroy()
            elseif type(item) == "thread" then
                task.cancel(item)
            elseif type(item) == "function" then
                item()
            end
        end)
    end
    table.clear(cleanupTasks)

    if genv.MyScript_Cleanup == cleanup then
        genv.MyScript_Cleanup = nil
    end
end

genv.MyScript_Cleanup = cleanup

