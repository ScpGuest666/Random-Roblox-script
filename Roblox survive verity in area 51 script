local function updateGunInvisibility()
    local character = player.Character
    
    -- 1. Hide Character Tools
    if character then
        for _, item in ipairs(character:GetChildren()) do
            if item:IsA("Tool") then
                for _, desc in ipairs(item:GetDescendants()) do
                    applyInvisibility(desc, isInvisible)
                end
            end
        end
    end

    -- 2. Hide Camera ViewModels
    local cam = workspace.CurrentCamera
    if cam then
        for _, child in ipairs(cam:GetChildren()) do
            for _, desc in ipairs(child:GetDescendants()) do
                applyInvisibility(desc, isInvisible)
            end
            applyInvisibility(child, isInvisible)
        end
    end

    -- 3. Hide Workspace ViewModels (Only scans children, NOT descendants, to prevent lag)
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("Model") and child ~= character then
            local cName = string.lower(child.Name)
            if string.find(cName, "viewmodel") or string.find(cName, "arm") or string.find(cName, "v_") or matchesGunName(child) then
                for _, desc in ipairs(child:GetDescendants()) do
                    applyInvisibility(desc, isInvisible)
                end
                applyInvisibility(child, isInvisible)
            end
        end
    end
end

