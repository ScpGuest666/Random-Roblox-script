-- ==========================================
-- NAME SEARCH & NORMALIZATION HARVESTER
-- ==========================================
local function sanitize(str)
    if type(str) ~= "string" then return "" end
    return string.lower(str):gsub("[%s%p%c]", "")
end

local function updateGunNamesCache()
    local names = {}
    local added = {}

    local function addName(str)
        local clean = sanitize(str)
        if clean ~= "" and not added[clean] and #clean >= 2 then
            added[clean] = true
            table.insert(names, clean)
        end
    end

    local backpack = player:FindFirstChild("Backpack")
    local character = player.Character

    local function scanTools(container)
        if not container then return end
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Tool") then
                addName(item.Name)
                for _, val in ipairs(item:GetChildren()) do
                    if val:IsA("StringValue") and val.Value ~= "" then addName(val.Value) end
                end
                for attrName, attrVal in pairs(item:GetAttributes()) do
                    if type(attrVal) == "string" and attrVal ~= "" then addName(attrVal) end
                end
            end
        end
    end

    scanTools(backpack)
    scanTools(character)

    local playerGui = player:FindFirstChild("PlayerGui")
    if playerGui then
        for _, gui in ipairs(playerGui:GetChildren()) do
            if gui:IsA("ScreenGui") and gui ~= screenGui then
                for _, desc in ipairs(gui:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local txt = desc.Text
                        if txt ~= "" and not string.find(txt, "Equip") and not string.find(txt, "Shop") and not string.find(txt, "$") then
                            addName(txt)
                        end
                    end
                end
            end
        end
    end

    cachedGunNames = names
end

local function matchesGunName(inst)
    if not inst then return false end
    local clean = sanitize(inst.Name)
    for _, name in ipairs(cachedGunNames) do
        if clean == name or string.find(clean, name, 1, true) or string.find(name, clean, 1, true) then
            return true
        end
    end
    return false
end

-- ==========================================
-- EVENT-DRIVEN ANTI-LAG & INVISIBILITY (ZERO CPU COST)
-- ==========================================
local function isCharacterRigPart(part)
    if not part:IsA("BasePart") then return false end
    local char = player.Character
    if not char then return false end
    if part.Parent == char then
        local name = part.Name
        local standardParts = {
            ["Head"] = true, ["Torso"] = true, ["HumanoidRootPart"] = true,
            ["Left Arm"] = true, ["Right Arm"] = true, ["Left Leg"] = true, ["Right Leg"] = true,
            ["UpperTorso"] = true, ["LowerTorso"] = true,
            ["LeftUpperArm"] = true, ["LeftLowerArm"] = true, ["LeftHand"] = true,
            ["RightUpperArm"] = true, ["RightLowerArm"] = true, ["RightHand"] = true,
            ["LeftUpperLeg"] = true, ["LeftLowerLeg"] = true, ["LeftFoot"] = true,
            ["RightUpperLeg"] = true, ["RightLowerLeg"] = true, ["RightFoot"] = true
        }
        if standardParts[name] then return true end
    end
    return false
end

local function applyInvisibility(inst, makeInvi)
    if inst:IsA("BasePart") then
        if isCharacterRigPart(inst) then return end
        if makeInvi then
            if not inst:GetAttribute("OrigTrans") then
                inst:SetAttribute("OrigTrans", inst.Transparency)
                inst:SetAttribute("OrigLocalTrans", inst.LocalTransparencyModifier)
                inst:SetAttribute("OrigShadow", inst.CastShadow)
            end
            inst.Transparency = 1
            inst.LocalTransparencyModifier = 1
            inst.CastShadow = false
        else
            local origT = inst:GetAttribute("OrigTrans")
            if origT then inst.Transparency = origT end
            local origLT = inst:GetAttribute("OrigLocalTrans")
            if origLT then inst.LocalTransparencyModifier = origLT end
            local origS = inst:GetAttribute("OrigShadow")
            if origS ~= nil then inst.CastShadow = origS end
        end
    elseif inst:IsA("Decal") or inst:IsA("Texture") then
        if inst.Parent and isCharacterRigPart(inst.Parent) and string.lower(inst.Name) == "face" then return end
        if makeInvi then
            if not inst:GetAttribute("OrigTrans") then inst:SetAttribute("OrigTrans", inst.Transparency) end
            inst.Transparency = 1
        else
            local orig = inst:GetAttribute("OrigTrans")
            if orig then inst.Transparency = orig end
        end
    elseif inst:IsA("ParticleEmitter") or inst:IsA("Beam") or inst:IsA("Trail") or inst:IsA("Highlight") or inst:IsA("PointLight") or inst:IsA("SurfaceLight") or inst:IsA("SpotLight") then
        if makeInvi then
            if not inst:GetAttribute("OrigEnabled") then inst:SetAttribute("OrigEnabled", inst.Enabled) end
            inst.Enabled = false
        else
            local orig = inst:GetAttribute("OrigEnabled")
            if orig ~= nil then inst.Enabled = orig else inst.Enabled = true end
        end
    elseif inst:IsA("Sound") then
        if makeInvi then
            if not inst:GetAttribute("OrigVol") then inst:SetAttribute("OrigVol", inst.Volume) end
            inst.Volume = 0
        else
            local orig = inst:GetAttribute("OrigVol")
            if orig ~= nil then inst.Volume = orig end
        end
    end
end

-- Intercepts laggy effects and fake arms the millisecond they spawn
local function handleNewDescendant(desc)
    if not isInvisible then return end
    
    local class = desc.ClassName
    -- 1. Instant Lag Neutralizer
    if class == "ParticleEmitter" or class == "Trail" or class == "Beam" or class == "Fire" or class == "Smoke" or class == "Sparkles" or class == "PointLight" or class == "SurfaceLight" or class == "SpotLight" then
        desc.Enabled = false
        return
    elseif class == "Sound" then
        desc.Volume = 0
        return
    elseif class == "Explosion" then
        desc.Visible = false
        return
    end

    if desc:IsA("BasePart") then
        local name = string.lower(desc.Name)
        if string.find(name, "muzzle") or string.find(name, "flash") or string.find(name, "effect") or string.find(name, "impact") or string.find(name, "spark") or string.find(name, "bullet") or string.find(name, "laser") or string.find(name, "projectile") then
            desc.Transparency = 1
            desc.CastShadow = false
            desc.CanCollide = false
            return
        end
    end

    -- 2. Instant ViewModel (Fake Arms) Hider
    local parent = desc.Parent
    if parent and parent:IsA("Model") and parent ~= player.Character then
        local pName = string.lower(parent.Name)
        if string.find(pName, "viewmodel") or string.find(pName, "arm") or string.find(pName, "v_") or matchesGunName(parent) then
            applyInvisibility(desc, true)
        end
    end
end

