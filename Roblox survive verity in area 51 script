-- WELD CACHING (ZERO LAG ARCH)
-- ==========================================
local function refreshCache()
    cachedWelds = {}
    updateGunNamesCache()
    
    local character = player.Character
    if not character then return end
    
    local tools = {}
    for _, item in ipairs(character:GetChildren()) do
        if item:IsA("Tool") then table.insert(tools, item) end
    end
    
    for index, tool in ipairs(tools) do
        local handle = tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart")
        if handle then
            local weld = nil
            for _, desc in ipairs(character:GetDescendants()) do
                if (desc:IsA("Weld") or desc:IsA("Motor6D")) and desc.Part1 == handle then
                    weld = desc
                    break
                end
            end
            if weld and weld.Part0 then
                table.insert(cachedWelds, {Weld = weld, Index = index, Total = #tools})
            end
        end
    end
end

local function setupCharacterListeners()
    local character = player.Character
    if not character then return end
    
    if charAddedConn then charAddedConn:Disconnect() end
    if charRemovedConn then charRemovedConn:Disconnect() end
    
    charAddedConn = character.ChildAdded:Connect(function(child)
        if child:IsA("Tool") or child:IsA("Model") or child:IsA("BasePart") then
            task.wait(0.08)
            refreshCache()
            if isInvisible then updateGunInvisibility() end
        end
    end)
    
    charRemovedConn = character.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then refreshCache() end
    end)
end

