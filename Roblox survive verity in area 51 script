-- Touch States
local currentMoveVector = Vector2.zero
local activeJoystickTouch = nil
local activeJumpTouch = nil
local activeFireTouch = nil
local isJumpHeld = false
local isFiring = false
local MAX_RADIUS = 45

local function isInsideGui(pos, gui)
    if not gui or not gui.Visible then return false end
    local gPos = gui.AbsolutePosition
    local gSize = gui.AbsoluteSize
    return pos.X >= gPos.X and pos.X <= (gPos.X + gSize.X) and pos.Y >= gPos.Y and pos.Y <= (gPos.Y + gSize.Y)
end

-- Joystick Input Tracking
joyBase.InputBegan:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) and not activeJoystickTouch then
        activeJoystickTouch = input
        local baseCenter = joyBase.AbsolutePosition + (joyBase.AbsoluteSize / 2)
        local inputPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = inputPos - baseCenter
        local dist = delta.Magnitude
        local clampedDist = math.min(dist, MAX_RADIUS)
        local dir = (dist > 0) and (delta / dist) or Vector2.zero
        local knobOffset = dir * clampedDist
        
        joyKnob.Position = UDim2.new(0.5, knobOffset.X, 0.5, knobOffset.Y)
        currentMoveVector = Vector2.new(knobOffset.X / MAX_RADIUS, knobOffset.Y / MAX_RADIUS)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == activeJoystickTouch then
        local baseCenter = joyBase.AbsolutePosition + (joyBase.AbsoluteSize / 2)
        local inputPos = Vector2.new(input.Position.X, input.Position.Y)
        local delta = inputPos - baseCenter
        local dist = delta.Magnitude
        local clampedDist = math.min(dist, MAX_RADIUS)
        local dir = (dist > 0) and (delta / dist) or Vector2.zero
        local knobOffset = dir * clampedDist
        
        joyKnob.Position = UDim2.new(0.5, knobOffset.X, 0.5, knobOffset.Y)
        currentMoveVector = Vector2.new(knobOffset.X / MAX_RADIUS, knobOffset.Y / MAX_RADIUS)
    end
end)

local function resetJoystick()
    activeJoystickTouch = nil
    currentMoveVector = Vector2.zero
    joyKnob.Position = UDim2.new(0.5, 0, 0.5, 0)
end

