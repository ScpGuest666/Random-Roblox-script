-- ============================================================================
-- ORBIT CALCULATION ENGINE (STRICT VEHICLE DETACHED PARTS ONLY)
-- ============================================================================
local function updateOrbitingBlocks(centerPart)
    if not isOrbitOn or not centerPart or not centerPart.Parent then
        if next(trackedOrbitParts) ~= nil then
            clearOrbitInstances()
        end
        return
    end

    boostNetworkOwnership()

    -- 1. Identify active welded vehicle parts and continuously register vehicle blocks
    local mainVehicleSet = {}
    local maxExtentRadius = 0
    local centerPos = centerPart.Position

    local connected = centerPart:GetConnectedParts(true)
    for _, p in ipairs(connected) do
        if p:IsA("BasePart") then
            mainVehicleSet[p] = true
            knownVehicleParts[p] = true -- Register as part of our vehicle

            local offset = (p.Position - centerPos)
            local cornerDist = offset.Magnitude + (p.Size.Magnitude * 0.5)
            if cornerDist > maxExtentRadius then
                maxExtentRadius = cornerDist
            end
        end
    end
    mainVehicleSet[centerPart] = true
    knownVehicleParts[centerPart] = true

    -- Also check for player's named boat model (BABFT specific compatibility)
    pcall(function()
        for _, model in ipairs(workspace:GetChildren()) do
            if model:IsA("Model") and string.find(string.lower(model.Name), string.lower(player.Name)) then
                for _, p in ipairs(model:GetDescendants()) do
                    if p:IsA("BasePart") then
                        knownVehicleParts[p] = true
                    end
                end
            end
        end
    end)

    -- Safe base radius calculated around vehicle dimensions
    local baseOrbitRadius = math.max(12, maxExtentRadius + 8)

    -- 2. Filter strictly for blocks that belong to our vehicle registry but are now detached
    local detachedBlocks = {}
    local character = player.Character

    for block, _ in pairs(knownVehicleParts) do
        if block and block.Parent and block:IsA("BasePart") and not block.Anchored then
            -- Only pick it up if it is detached from our welded body and not our character
            if not mainVehicleSet[block] and (not character or not block:IsDescendantOf(character)) then
                table.insert(detachedBlocks, block)
            end
        elseif not block or not block.Parent then
            knownVehicleParts[block] = nil
        end
    end

    -- Cleanup parts that re-welded or were destroyed
    local currentSet = {}
    for _, p in ipairs(detachedBlocks) do currentSet[p] = true end
    for p, _ in pairs(trackedOrbitParts) do
        if not currentSet[p] then
            if p and p.Parent then
                local bp = p:FindFirstChild(orbitBodyPosName)
                if bp then bp:Destroy() end
                local bg = p:FindFirstChild(orbitBodyGyroName)
                if bg then bg:Destroy() end
            end
            trackedOrbitParts[p] = nil
        end
    end

    local numBlocks = #detachedBlocks
    if numBlocks == 0 then return end

    local timeNow = tick() * orbitSpeed

    -- 3. Position and rotate each detached block along the calculated orbit ring
    for index, block in ipairs(detachedBlocks) do
        trackedOrbitParts[block] = true

        local bp = block:FindFirstChild(orbitBodyPosName)
        if not bp then
            bp = Instance.new("BodyPosition")
            bp.Name = orbitBodyPosName
            bp.MaxForce = Vector3.new(1e6, 1e6, 1e6)
            bp.P = 15000
            bp.D = 800
            bp.Parent = block
        end

        local bg = block:FindFirstChild(orbitBodyGyroName)
        if not bg then
            bg = Instance.new("BodyGyro")
            bg.Name = orbitBodyGyroName
            bg.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
            bg.P = 3000
            bg.D = 150
            bg.Parent = block
        end

        local angle = timeNow + (index * (2 * math.pi / numBlocks))
        local partExtraRadius = (block.Size.Magnitude * 0.5)
        local totalRadius = baseOrbitRadius + partExtraRadius
        
        local heightWave = math.sin(timeNow * 1.2 + index) * 1.5

        local targetPos = centerPos + Vector3.new(
            math.cos(angle) * totalRadius,
            heightWave,
            math.sin(angle) * totalRadius
        )

        bp.Position = targetPos
        bg.CFrame = CFrame.new(targetPos, centerPos) * CFrame.Angles(0, math.rad(90), 0)
    end
end

