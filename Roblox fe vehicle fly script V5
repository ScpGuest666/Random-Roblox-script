-- INPUT & LOOP HANDLERS
-- ============================================================================
local function handleInput(dt)
    if not isAlive then return end
    local character = player.Character
    if not character then return end
    
    local humanoid = character:FindFirstChild("Humanoid")
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not rootPart then return end
    
    local flightPart = getFlightPart(humanoid)
    
    if FlyEnabled and flightPart then
        local gyro = flightPart:FindFirstChild(gyroHandlerName)
        if not VelocityHandler or not gyro then return end
        
        local speed = tonumber(SpeedTextBox.Text) or 1
        local targetVelocity = Vector3.new()
        local movementCFrame
        
        if isAntiLockOn then
            movementCFrame = gyro.CFrame 
        elseif isPitchOn then
            local camera = workspace.CurrentCamera
            local lookVector = camera.CFrame.LookVector
            movementCFrame = CFrame.new(flightPart.Position, flightPart.Position + lookVector)
        elseif gyro then
            local lookVector = gyro.CFrame.LookVector
            movementCFrame = CFrame.new(flightPart.Position, flightPart.Position + Vector3.new(lookVector.X, 0, lookVector.Z))
        else
            movementCFrame = flightPart.CFrame
        end
        
        -- === VELOCITY CALCULATION ===
        if isHelicopterOn then
            local moveVecHorizontal = Vector3.new()
            local verticalCorrection = 0
            
            for _, direction in ipairs(movementDirection) do
                if direction == "forward" then
                    moveVecHorizontal += movementCFrame.LookVector * forwardVelocity
                elseif direction == "backward" then
                    moveVecHorizontal += -movementCFrame.LookVector * forwardVelocity
                elseif direction == "left" then
                    moveVecHorizontal += movementCFrame.RightVector * -leftVelocity
                elseif direction == "right" then
                    moveVecHorizontal += movementCFrame.RightVector * rightVelocity
                end
            end
            
            if humanoid.SeatPart then
                local thumbstickDirection = Vector2.new(0, 0)
                pcall(function()
                    local controlModule = require(player.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
                    thumbstickDirection = controlModule:GetMoveVector()
                end)
                
                if thumbstickDirection.Magnitude > 0 then
                    moveVecHorizontal += (
                        movementCFrame.RightVector * thumbstickDirection.X * forwardVelocity * 2 +
                        movementCFrame.LookVector * -thumbstickDirection.Z * forwardVelocity * 2
                    )
                end
            end
            
            local isMovingUp = table.find(movementDirection, "up")
            local isMovingDown = table.find(movementDirection, "down")
            local isVerticalInputActive = isMovingUp or isMovingDown

            if not heliTargetY then
                heliTargetY = flightPart.Position.Y
            end

            if isVerticalInputActive then
                if isMovingUp then
                    verticalCorrection = upVelocity
                elseif isMovingDown then
                    verticalCorrection = -downVelocity
                end
                
                if isSmoothModeOn then
                    heliTargetY = flightPart.Position.Y + (currentVelocityVector.Y * dt)
                else
                    heliTargetY = flightPart.Position.Y + verticalCorrection * dt
                end
            else
                if math.abs(currentVelocityVector.Y) > 2 then
                    heliTargetY = flightPart.Position.Y
                end
                local currentY = flightPart.Position.Y
                verticalCorrection = (heliTargetY - currentY) * HELI_P_GAIN 
            end
            
            targetVelocity = Vector3.new(moveVecHorizontal.X, verticalCorrection, moveVecHorizontal.Z)
            
        else
            for _, direction in ipairs(movementDirection) do
                if direction == "forward" then
                    targetVelocity += movementCFrame.LookVector * forwardVelocity
                elseif direction == "backward" then
                    targetVelocity += -movementCFrame.LookVector * forwardVelocity
                elseif direction == "left" then
                    targetVelocity += movementCFrame.RightVector * -leftVelocity
                elseif direction == "right" then
                    targetVelocity += movementCFrame.RightVector * rightVelocity
                elseif direction == "up" then
                    targetVelocity += Vector3.new(0, upVelocity, 0)
                elseif direction == "down" then
                    targetVelocity += Vector3.new(0, -downVelocity, 0)
                end
            end
        end
        
        targetVelocity *= speed
        
        if isSmoothModeOn then
            currentVelocityVector = currentVelocityVector:Lerp(targetVelocity, smoothingFactor)
            VelocityHandler.Velocity = currentVelocityVector
        else
            VelocityHandler.Velocity = targetVelocity
            currentVelocityVector = targetVelocity 
        end
        
        for _, direction in ipairs(movementDirection) do
            if direction == "rotateLeft" and gyro then
                gyro.CFrame = gyro.CFrame * CFrame.Angles(0, math.rad(-rotationSpeed), 0)
            elseif direction == "rotateRight" and gyro then
                gyro.CFrame = gyro.CFrame * CFrame.Angles(0, math.rad(rotationSpeed), 0)
            end
        end

        -- Gyro / Pitch / Heli dynamics
        if gyro then
            if isAntiLockOn then
                if isYawLocked and humanoid.SeatPart then
                    gyro.CFrame = humanoid.SeatPart.CFrame
                elseif isHelicopterOn then
                    local forwardInput = 0
                    local rightInput = 0
                    
                    for _, dir in ipairs(movementDirection) do
                        if dir == "forward" then forwardInput = forwardInput + 1 end
                        if dir == "backward" then forwardInput = forwardInput - 1 end
                        if dir == "right" then rightInput = rightInput + 1 end
                        if dir == "left" then rightInput = rightInput - 1 end
                    end
                    
                    if humanoid.SeatPart then
                        local thumbstickDirection = Vector2.new(0, 0)
                        pcall(function()
                            local controlModule = require(player.PlayerScripts:WaitForChild("PlayerModule"):WaitForChild("ControlModule"))
                            thumbstickDirection = controlModule:GetMoveVector()
                        end)
                        
                        if thumbstickDirection.Magnitude > 0 then
                            forwardInput = forwardInput + (-thumbstickDirection.Z)
                            rightInput = rightInput + thumbstickDirection.X
                        end
                    end
                    
                    forwardInput = math.clamp(forwardInput, -1, 1)
                    rightInput = math.clamp(rightInput, -1, 1)
                    
                    local desiredPitch = 0
                    local desiredRoll = 0
                    local dynamicSmoothing = heliPitchSmoothing

                    if isSmoothModeOn then
                        local flatLook = (gyro.CFrame.LookVector * Vector3.new(1, 0, 1)).Unit
                        local flatRight = (gyro.CFrame.RightVector * Vector3.new(1, 0, 1)).Unit
                        local maxSpd = math.max(1, forwardVelocity * speed)
                        
                        local forwardRelVel = math.clamp(currentVelocityVector:Dot(flatLook) / maxSpd, -1, 1)
                        local rightRelVel = math.clamp(currentVelocityVector:Dot(flatRight) / maxSpd, -1, 1)

                        local effectiveForward = (forwardInput * 0.55) + (forwardRelVel * 0.45)
                        local effectiveRight = (rightInput * 0.55) + (rightRelVel * 0.45)

                        local yawTurn = 0
                        if table.find(movementDirection, "rotateLeft") then yawTurn = yawTurn - 1 end
                        if table.find(movementDirection, "rotateRight") then yawTurn = yawTurn + 1 end
                        local turnBank = math.rad(-heliMaxRollDeg * 0.35 * yawTurn * math.clamp(forwardRelVel, 0, 1))

                        desiredPitch = math.rad(-heliMaxPitchDeg * effectiveForward)
                        desiredRoll = math.rad(-heliMaxRollDeg * effectiveRight) + turnBank
                        dynamicSmoothing = 0.09
                    else
                        desiredPitch = math.rad(-heliMaxPitchDeg * forwardInput)
                        desiredRoll = math.rad(-heliMaxRollDeg * rightInput)
                        dynamicSmoothing = heliPitchSmoothing
                    end
                    
                    local currentYaw = CFrame.new(flightPart.Position, flightPart.Position + gyro.CFrame.LookVector * Vector3.new(1, 0, 1).Unit)
                    local targetCFrame = currentYaw * CFrame.Angles(desiredPitch, 0, desiredRoll)
                    
                    gyro.CFrame = gyro.CFrame:Lerp(targetCFrame, dynamicSmoothing)
                else
                    local flatLookVector = gyro.CFrame.LookVector * Vector3.new(1, 0, 1)
                    local targetCFrame = CFrame.new(flightPart.Position, flightPart.Position + flatLookVector)
                    gyro.CFrame = targetCFrame
                end
            elseif not isAntiLockOn then
                local camera = workspace.CurrentCamera
                
                if isPitchOn then
                    local moveDir = currentVelocityVector 
                    
                    if moveDir.Magnitude > 1 then
                        local cameraCFrame = camera.CFrame
                        local localMove = cameraCFrame:PointToObjectSpace(cameraCFrame.Position + moveDir)
                        local maxHorizontalSpeed = forwardVelocity * speed
                        
                        local forwardTiltRatio = math.clamp(-localMove.Z / maxHorizontalSpeed, -1, 1)
                        local sidewaysTiltRatio = math.clamp(localMove.X / maxHorizontalSpeed, -1, 1)
                        
                        local forwardTilt = forwardTiltRatio * math.rad(heliMaxPitchDeg)
                        local sidewaysTilt = sidewaysTiltRatio * math.rad(heliMaxRollDeg)
                        
                        local baseCFrame = CFrame.new(flightPart.Position, flightPart.Position + cameraCFrame.LookVector)
                        gyro.CFrame = baseCFrame * CFrame.Angles(forwardTilt, 0, sidewaysTilt)
                    else
                        local flatLookVector = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
                        gyro.CFrame = CFrame.new(flightPart.Position, flightPart.Position + flatLookVector)
                    end
                else
                    local flatLookVector = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
                    gyro.CFrame = CFrame.new(flightPart.Position, flightPart.Position + flatLookVector)
                end
            end
        end

        -- Update Detached Orbiting Blocks
        updateOrbitingBlocks(flightPart)
    else
        if VelocityHandler then
            VelocityHandler.Velocity = Vector3.new()
        end
        currentVelocityVector = Vector3.new(0, 0, 0)
        heliTargetY = nil 
        clearOrbitInstances()
    end
end

local function backupButtonPositions()
    for button, originalPosition in pairs(originalButtonPositions) do
        if button and button.Parent and button.Position == UDim2.new(0, 0, 0, 0) then
            button.Position = originalPosition
        end
    end
end

-- ============================================================================
-- CENTRAL CLEANUP IMPLEMENTATION
-- ============================================================================
local function cleanup()
    isAlive = false

    DisableFlight()
    
    if seatConnection then seatConnection:Disconnect() end
    if unseatConnection then unseatConnection:Disconnect() end
    seatConnection = nil
    unseatConnection = nil

    for _, item in ipairs(cleanupTasks) do
        pcall(function()
            if typeof(item) == "RBXScriptConnection" then
                item:Disconnect()
            elseif typeof(item) == "Instance" then
                item:Destroy()
            elseif type(item) == "thread" then
                task.cancel(item)
            elseif type(item) == "function" then
                item()
            end
        end)
    end
    table.clear(cleanupTasks)

    if genv.VehicleFly_Cleanup == cleanup then
        genv.VehicleFly_Cleanup = nil
    end
end

genv.VehicleFly_Cleanup = cleanup

-- ============================================================================
-- EVENT LISTENERS & SETUP
-- ============================================================================
local function setupEventListeners()
    local function resetControllerOnSpawn()
        ControllerGui.Enabled = false
        LeftSideGui.Enabled = false
    end
    registerCleanup(player.CharacterAdded:Connect(resetControllerOnSpawn))
    registerCleanup(player.CharacterRemoving:Connect(resetControllerOnSpawn))

    registerCleanup(IncreaseButton.MouseButton1Click:Connect(function()
        local currentSpeed = tonumber(SpeedTextBox.Text) or 1
        SpeedTextBox.Text = tostring(currentSpeed + 1)
    end))
    
    registerCleanup(DecreaseButton.MouseButton1Click:Connect(function()
        local currentSpeed = tonumber(SpeedTextBox.Text) or 1
        SpeedTextBox.Text = tostring(math.max(1, currentSpeed - 1))
    end))
    
    local function registerMovementButton(btn, dir)
        registerCleanup(btn.MouseButton1Down:Connect(function()
            table.insert(movementDirection, dir)
        end))
        registerCleanup(btn.MouseButton1Up:Connect(function()
            for i = #movementDirection, 1, -1 do
                if movementDirection[i] == dir then
                    table.remove(movementDirection, i)
                end
            end
        end))
    end

    registerMovementButton(ForwardButton, "forward")
    registerMovementButton(BackwardButton, "backward")
    registerMovementButton(LeftButton, "left")
    registerMovementButton(RightButton, "right")
    registerMovementButton(UpButton, "up")
    registerMovementButton(DownButton, "down")
    registerMovementButton(RotateLeftButton, "rotateLeft")
    registerMovementButton(RotateRightButton, "rotateRight")
    
    registerCleanup(AntiLockButton.MouseButton1Click:Connect(function()
        isAntiLockOn = not isAntiLockOn
        if isAntiLockOn then
            AntiLockButton.Text = "A-L On"
            if isPitchOn then
                PitchButton.Text = "Pitch: Off"
                isPitchOn = false
            end
        else
            AntiLockButton.Text = "A-L"
            isYawLocked = false
            if isHelicopterOn then
                isHelicopterOn = false
                HelicopterButton.Text = "Heli"
                heliTargetY = nil
            end
        end
    end))
    
    registerCleanup(PitchButton.MouseButton1Click:Connect(function()
        if isAntiLockOn then
            PitchButton.Text = "Pitch: Off"
            isPitchOn = false
        else
            isPitchOn = not isPitchOn
            PitchButton.Text = isPitchOn and "Pitch: On" or "Pitch: Off"
        end
    end))

    registerCleanup(SmoothButton.MouseButton1Click:Connect(function()
        isSmoothModeOn = not isSmoothModeOn
        if isSmoothModeOn then
            SmoothButton.Text = "Smooth On"
        else
            SmoothButton.Text = "Smooth"
            currentVelocityVector = Vector3.new(0, 0, 0)
        end
    end))
    
    registerCleanup(HelicopterButton.MouseButton1Click:Connect(function()
        if not isAntiLockOn then
            HelicopterButton.Text = "Heli (A-L req)"
            task.delay(1, function()
                if HelicopterButton and HelicopterButton.Parent then
                    HelicopterButton.Text = isHelicopterOn and "Heli On" or "Heli"
                end
            end)
            return
        end

        isHelicopterOn = not isHelicopterOn
        if isHelicopterOn then
            HelicopterButton.Text = "Heli On"
            local char = player.Character
            local humanoid = char and char:FindFirstChild("Humanoid")
            local part = getFlightPart(humanoid)
            if part then
                heliTargetY = part.Position.Y
            end
        else
            HelicopterButton.Text = "Heli"
            heliTargetY = nil
        end
    end))

    -- Fly Toggle
    registerCleanup(FlyButton.MouseButton1Click:Connect(function()
        FlyEnabled = not FlyEnabled
        local character = player.Character
        local humanoid = character and character:FindFirstChild("Humanoid")
        
        if FlyEnabled then
            FlyButton.Text = "UnFly"
            
            if humanoid then
                if seatConnection then seatConnection:Disconnect() end
                if unseatConnection then unseatConnection:Disconnect() end
                
                local function onSeatChange()
                    local seatPart = humanoid.SeatPart
                    
                    if seatPart then
                        setupFlyInstances(seatPart)
                        handleSeatLock(humanoid)
                        if isHelicopterOn then
                            heliTargetY = seatPart.Position.Y
                        end
                    elseif FlyEnabled and VelocityHandler and VelocityHandler.Parent then
                        -- Hovering in vehicle unseated
                    else
                        DisableFlight()
                    end
                end

                onSeatChange()
                seatConnection = humanoid:GetPropertyChangedSignal("SeatPart"):Connect(onSeatChange)
                unseatConnection = humanoid:GetPropertyChangedSignal("SeatPart"):Connect(onSeatChange)
            end
        else
            FlyButton.Text = "Fly"
            DisableFlight()
            if seatConnection then seatConnection:Disconnect() end
            if unseatConnection then unseatConnection:Disconnect() end
            seatConnection = nil
            unseatConnection = nil
        end
    end))
    
    -- Orbit Toggle
    registerCleanup(OrbitButton.MouseButton1Click:Connect(function()
        isOrbitOn = not isOrbitOn
        OrbitButton.Text = isOrbitOn and "Orbit On" or "Orbit"
        if not isOrbitOn then
            clearOrbitInstances()
        end
    end))
    
    registerCleanup(ControllerButton.MouseButton1Click:Connect(function()
        controllerEnabled = not controllerEnabled
        ControllerGui.Enabled = controllerEnabled
        LeftSideGui.Enabled = controllerEnabled
    end))
    
    registerCleanup(DestroyButton.MouseButton1Click:Connect(cleanup))

    registerCleanup(MinimizeButton.MouseButton1Click:Connect(function()
        isGuiMinimized = not isGuiMinimized
        local currentPos = MainFrame.Position
        
        if isGuiMinimized then
            MinimizeButton.Text = "⇩"
            MainFrame:TweenSizeAndPosition(
                UDim2.new(0, 100, 0, 25), 
                UDim2.new(currentPos.X.Scale, currentPos.X.Offset, 
                         currentPos.Y.Scale, currentPos.Y.Offset + (115 - 25) / 2), 
                Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true
            )
            Title.Visible = true 
            Title.Size = UDim2.new(1, 0, 1, 0) 
            Title.Position = UDim2.new(0, 0, 0, 0) 
            InnerFrame.Visible = false 
        else
            MinimizeButton.Text = "⇧"
            MainFrame:TweenSizeAndPosition(
                UDim2.new(0, 100, 0, 115), 
                UDim2.new(currentPos.X.Scale, currentPos.X.Offset, 
                         currentPos.Y.Scale, currentPos.Y.Offset - (115 - 25) / 2), 
                Enum.EasingDirection.Out, Enum.EasingStyle.Quad, 0.25, true
            )
            Title.Visible = true
            Title.Size = UDim2.new(1, 0, 0.2, 0) 
            Title.Position = UDim2.new(0, 0, 0, 0) 
            InnerFrame.Visible = true
        end
    end))

    registerCleanup(RunService.RenderStepped:Connect(handleInput))
    registerCleanup(RunService.Heartbeat:Connect(backupButtonPositions))
end

